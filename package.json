{
  "name": "keuangan-busdev",
  "version": "1.0.0",
  "description": "Aplikasi Rekapitulasi Dana Persekot, Reimbursement & Opname Kas Fisik Busdev 2026",
  "main": "electron/main.js",
  "author": "irvan <begolo12>",
  "scripts": {
    "dev": "next dev -p 8088",
    "build": "next build",
    "start": "next start -p 8088",
    "electron": "electron .",
    "electron:dev": "concurrently \"next dev -p 8088\" \"wait-on http://localhost:8088 && electron .\"",
    "electron:pack": "next build && electron-builder --dir",
    "electron:build": "next build && electron-builder --win"
  },
  "build": {
    "appId": "com.keuanganbusdev.app",
    "productName": "Keuangan Busdev 2026",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json",
      ".env.production"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "autoprefixer": "^10.5.5",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.42.0",
    "next": "14.2.25",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.17",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0"
  }
}
